; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

_custom_features="perf"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Tiny Track Rally"
config/tags=PackedStringArray("starterkit")
run/main_scene="res://scenes/game.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.094, 0.125, 0.25, 1)
boot_splash/image="res://splash-screen.png"
config/icon="res://icon.png"

[admob]

general/android/app_id="ca-app-pub-4674211063760769~5041164876"

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[autoload]

Game="*res://scripts/game.gd"
Loc="*res://scripts/loc.gd"
Sound="*res://scripts/sound.gd"
Ads="*res://scripts/ads.gd"
IAP="*res://scripts/iap.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[filesystem]

import/fbx/enabled=false

